<project
	xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="httpS://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.visorweb</groupId>
	<artifactId>visorweb-junitPOM</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<properties>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<junit.jupiter.version>6.1.3</junit.jupiter.version>
		<junit.platform.suite.version>6.1.3</junit.platform.suite.version>
		<junit.platform.launcher.version>6.1.3</junit.platform.launcher.version>
		<assertj.version>3.27.7</assertj.version>
		<selenium.version>4.49.0</selenium.version>
		<filo.version>1.21</filo.version>
		<aspectj.version>1.9.25.1</aspectj.version>
		<!-- Reportes con AllureReport -->
		<allure.version>2.35.4</allure.version>

	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.qameta.allure</groupId>
				<artifactId>allure-bom</artifactId>
				<version>${allure.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<!-- Reportes con AllureReport -->
		<dependency>
			<groupId>io.qameta.allure</groupId>
			<artifactId>allure-jupiter</artifactId>
		</dependency>

		<!-- Source:
		https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter-api -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.jupiter.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Source:
		https://mvnrepository.com/artifact/org.seleniumhq.selenium/selenium-java -->
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-java</artifactId>
			<version>${selenium.version}</version>
			<scope>compile</scope>
		</dependency>
		<!-- Source:
		https://mvnrepository.com/artifact/org.junit.platform/junit-platform-suite -->
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-suite</artifactId>
			<version>${junit.platform.suite.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Source:
		https://mvnrepository.com/artifact/org.junit.platform/junit-platform-launcher -->
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<version>${junit.platform.launcher.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Source: https://mvnrepository.com/artifact/org.assertj/assertj-core -->
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<version>${assertj.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- Source:
		https://mvnrepository.com/artifact/com.codoid.products/fillo -->
		<dependency>
			<groupId>com.codoid.products</groupId>
			<artifactId>fillo</artifactId>
			<version>${filo.version}</version>
			<scope>compile</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- 🟢 Plugin para compilar el código fuente Java -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
			</plugin>

			<!-- 🚀 EL PUENTE: Plugin Surefire configurado para JUnit 5 y tu
			Enum -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<systemPropertyVariables>
						<!-- Pasa la propiedad 'browser' de la terminal hacia tu
						clase PruebaBase -->
						<browser>${browser}</browser>
					</systemPropertyVariables>
					<!-- 🟢 AGREGADO: Configuración del agente para que Allure
					escuche las anotaciones @Step -->
					<argLine>
						-javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
					</argLine>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>org.aspectj</groupId>
						<artifactId>aspectjweaver</artifactId>
						<version>${aspectj.version}</version>
					</dependency>
				</dependencies>
			</plugin>
			<!-- 🟢 LA SOLUCIÓN: Agrega este plugin aquí para actualizar el
			motor de renderizado HTML -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-site-plugin</artifactId>
				<version>3.22.0</version> <!-- Esta versión sí incluye Doxia 2 y
				resuelve el NoSuchMethodError -->
			</plugin>
			<!-- Reportes con AllureReport -->
			<plugin>
				<groupId>io.qameta.allure</groupId>
				<artifactId>allure-maven</artifactId>
				<version>2.12.0</version>
			</plugin>

		</plugins>

	</build>
	<!-- FORMA CORRECTA: En la sección de reportes al final de tu pom.xml
		Reporte nativo HTML de maven surfire report-->
	<reporting>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-report-plugin</artifactId>
				<version>3.6.0</version> <!-- Usando la última versión del
					repositorio -->
			</plugin>
			<!-- EL NUEVO PLUGIN: Añade los gráficos, resúmenes y métricas del
			proyecto -->
			<!-- 2. CORRECCIÓN: Filtra los reportes de información del proyecto -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-project-info-reports-plugin</artifactId>
				<version>3.6.0</version>
				<reportSets>
					<reportSet>
						<reports>
							<!-- Dejamos activos solo los resúmenes visuales
							seguros -->
							<report>index</report>
							<report>summary</report>
							<!-- Al NO incluir 'dependencies' aquí, evitamos que
							analice los metadatos viejos de Fillo -->
						</reports>
					</reportSet>
				</reportSets>
			</plugin>
		</plugins>
	</reporting>

</project>